# Local settings of the docker compose stack. Copy to .env (./start.sh --init-env generates random secrets).
# The values below are placeholders that work for a first local run - never use them anywhere else.
# Secrets are read once, when the database volume is empty; after changing them: ./start.sh --clean

# Superuser of the local PostgreSQL (used only by the init scripts and by you with psql).
POSTGRES_PASSWORD=local-postgres-change-me
# The only role PostgREST logs in with. Letters and digits only - it goes into a connection URI.
AUTHENTICATOR_PASSWORD=localauthenticatorchangeme
# HS256 key shared by the database (signs tokens in api.login) and PostgREST (verifies them). At least 32 characters.
# Generate: openssl rand -hex 32
JWT_SECRET=local-jwt-secret-change-me-0123456789abcdef
# Token lifetime, a PostgreSQL interval.
JWT_LIFETIME="8 hours"

# Host ports (127.0.0.1 only).
WEB_PORT=6500
API_PORT=6501
DB_PORT=6502
