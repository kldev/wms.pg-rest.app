@* Create or edit a warehouse; the database checks the code (unique, format). *@
@inject PostgRestClient Api
@inject NavigationManager Navigation

<form @onsubmit="SaveAsync" class="space-y-4" data-testid="warehouse-form">
    <Alert Message="@_errors.Form" />
    <Field For="code" Label="Code" Error="@_errors["code"]">
        <input id="code" class="input code uppercase" maxlength="16" autocomplete="off" spellcheck="false" @bind="_code" aria-invalid="@(_errors["code"] is not null ? "true" : null)" />
    </Field>
    <Field For="name" Label="Name" Error="@_errors["name"]">
        <input id="name" class="input" maxlength="200" @bind="_name" aria-invalid="@(_errors["name"] is not null ? "true" : null)" />
    </Field>
    <div class="flex justify-end gap-2 pt-1">
        <button type="button" class="btn" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="btn btn-primary" disabled="@_saving">@(Existing is null ? "Create warehouse" : "Save")</button>
    </div>
</form>

@code {
    private readonly FormErrors _errors = new("code", "name");
    private string _code = "";
    private string _name = "";
    private bool _saving;

    [Parameter]
    public Warehouse? Existing { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override void OnParametersSet()
    {
        _code = Existing?.Code ?? "";
        _name = Existing?.Name ?? "";
        _errors.Clear();
    }

    private async Task SaveAsync()
    {
        _errors.Clear();
        _saving = true;
        try
        {
            var row = new { code = _code, name = _name };
            if (Existing is null)
            {
                await Api.CreateAsync<Warehouse>("warehouses", row);
            }
            else
            {
                await Api.UpdateAsync("warehouses", Existing.Id, row);
            }
            await OnSaved.InvokeAsync();
        }
        catch (PostgRestException e) when (e.SessionExpired)
        {
            Navigation.NavigateTo("auth/session-expired", forceLoad: true);
        }
        catch (PostgRestException e)
        {
            _errors.Show(e);
        }
        catch (HttpRequestException)
        {
            _errors.ShowUnreachable();
        }
        finally
        {
            _saving = false;
        }
    }
}
