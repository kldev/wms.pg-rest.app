@* A dialog over the page. Escape and the backdrop close it. *@
@if (Open)
{
    <div class="fixed inset-0 z-40 bg-ink/40" @onclick="OnClose"></div>
    <div role="dialog" aria-modal="true" aria-labelledby="modal-title" @onkeydown="KeyDown"
         class="fixed inset-x-4 top-[10vh] z-50 mx-auto max-w-md rounded-lg border border-line-strong bg-surface p-5 shadow-xl">
        <div class="mb-4 flex items-start justify-between gap-4">
            <h2 id="modal-title" class="text-lg font-semibold">@Title</h2>
            <button type="button" class="btn btn-ghost h-7 px-1" @onclick="OnClose" aria-label="Close">✕</button>
        </div>
        @ChildContent
    </div>
}

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
