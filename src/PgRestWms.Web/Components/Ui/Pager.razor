@* Paging through the URL (?page=n&size=m); the total comes from PostgREST's Content-Range. *@
<nav class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm text-muted" aria-label="Pages">
    <span data-testid="range">
        @if (Total == 0)
        {
            <text>No rows</text>
        }
        else
        {
            <text>@First–@Last of @Total</text>
        }
    </span>
    <div class="flex items-center gap-2">
        @foreach (var size in Sizes)
        {
            <a href="@SizeHref(size)" class="rounded px-1.5 font-mono text-xs @(size == Size ? "bg-ink text-paper" : "hover:text-ink")">@size</a>
        }
        <span class="mx-1 h-4 w-px bg-line"></span>
        @if (Page > 1)
        {
            <a href="@PageHref(Page - 1)" class="btn h-8" rel="prev">Previous</a>
        }
        else
        {
            <span class="btn h-8 opacity-40" aria-disabled="true">Previous</span>
        }
        @if (Last < Total)
        {
            <a href="@PageHref(Page + 1)" class="btn h-8" rel="next">Next</a>
        }
        else
        {
            <span class="btn h-8 opacity-40" aria-disabled="true">Next</span>
        }
    </div>
</nav>

@code {
    public static readonly int[] Sizes = [10, 20, 50, 100];

    [Parameter]
    public int Page { get; set; }

    [Parameter]
    public int Size { get; set; }

    [Parameter]
    public int Total { get; set; }

    [Parameter, EditorRequired]
    public Func<int, string> PageHref { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<int, string> SizeHref { get; set; } = null!;

    private int First => (Page - 1) * Size + 1;
    private int Last => Math.Min(Page * Size, Total);
}
