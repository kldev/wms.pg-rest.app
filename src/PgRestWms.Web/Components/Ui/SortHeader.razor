@* A column header that sorts the list through the URL (?sort=column&desc=true). *@
<th class="@(Numeric ? "text-right" : "")" aria-sort="@AriaSort">
    <a href="@Href" class="inline-flex items-center gap-1 hover:text-ink @(Active ? "text-ink" : "")">
        @Label
        <span class="font-mono text-[10px]" aria-hidden="true">@(Active ? (Descending ? "▼" : "▲") : "")</span>
    </a>
</th>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public string Href { get; set; } = "";

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public bool Descending { get; set; }

    [Parameter]
    public bool Numeric { get; set; }

    private string AriaSort => !Active ? "none" : Descending ? "descending" : "ascending";
}
